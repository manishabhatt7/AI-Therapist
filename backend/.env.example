
# App Settings
app_name=AI Therapist API
debug=true
version=api/v1

# Groq Settings
GROQ_API_KEY=your_groq_api_key
# Model Settings
LLM_MODEL=llama-3.1-8b-instant
SENTIMENT_MODEL=llama-3.1-8b-instant
WHISPER_MODEL=whisper-large-v3-turbo
TTS_MODEL=canopylabs/orpheus-v1-english
TTS_VOICE=hannah

# ─── OpenAI (optional – for TTS or alternative Whisper) ──────
OPENAI_API_KEY=sk_your_key_here

# ─── Phase 2: Voice settings ─────────────────────────────────
WHISPER_BACKEND=groq          # groq | openai | local
ENABLE_TTS=false              # set true to enable voice responses

# DATABASE
POSTGRES_HOST=localhost # RUNNING LOCALLY
# POSTGRES_HOST=postgres #RUNNING APP INSIDE DOCKER
POSTGRES_PORT=yourpostgresport
POSTGRES_USER=yourpostgresuser
POSTGRES_PASSWORD=yourpostgrespassword
POSTGRES_DB=yourpostgresdb
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}


# Email Configuration (Gmail example)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password  # Use Gmail App Password, not regular password (without space in between)
SENDER_EMAIL=your_email@gmail.com

FRONTEND_URL=http://localhost:8501

# Verification Token Expiry (in hours)
VERIFICATION_TOKEN_EXPIRY_MINUTES=1440  # 24 hours
